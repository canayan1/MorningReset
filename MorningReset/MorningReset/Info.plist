<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Inner Light</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>tr</string>
		<string>es</string>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>
